@model Lab0.Models.Product

@{
    ViewBag.Title = "Szczegóły produktu";
    Layout = "_Layout";
}

<h2>Szczegóły produktu</h2>

<p><b>Nazwa:</b> @Model.Name</p>
<p><b>Cena:</b> @Model.Price</p>
<p><b>Producent:</b> @Model.Manufacturer</p>
<p><b>Data produkcji:</b> @Model.ProductionDate.ToShortDateString()</p>
<p><b>Opis:</b> @Model.Description</p>

<a asp-action="Index">Powrót</a>