@model List<Lab0.Models.Product>

@{
    ViewBag.Title = "Lista produktów";
    Layout = "_Layout";
}
<h2>Lista produktów</h2>

@if (Model.Count > 0)
{
    <table class="table">
        <tr>
            <th>@Html.DisplayNameFor(m => m[0].Name)</th>
            <th>@Html.DisplayNameFor(m => m[0].Price)</th>
            <th>@Html.DisplayNameFor(m => m[0].Category)</th>
            <th>Akcje</th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>@item.Category.GetDisplayName()</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id">Szczegóły</a>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edituj</a>
                    <a asp-action="Delete" asp-route-id="@item.Id">Usuń</a>
                </td>
            </tr>
        }
    </table>
    <div>
    <a asp-action="Create">Dodaj produkt</a>
    </div>
}
else
{
    <p>Brak produktów</p>
    <a asp-action="Create">Dodaj produkt</a>
}
@if (ViewBag.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= ViewBag.TotalPages; i++)
            {
                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
