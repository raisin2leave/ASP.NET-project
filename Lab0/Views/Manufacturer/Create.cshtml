@model Lab0.Models.ManufacturerModel

@{
    ViewBag.Title = "Dodaj producenta";
    Layout = "_Layout";
}

            <h2>Dodaj nowego producenta</h2>

            <form asp-action="Create" asp-controller="Manufacturer" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control"/>
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary">Zapisz</button>
                <a asp-action="Index" class="btn btn-secondary">Lista producentów</a>
            </form>